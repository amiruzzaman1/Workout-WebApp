{
  "expo": {
    "name": "Forge",
    "slug": "workout-webapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amiruzzaman.forge"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amiruzzaman.forge",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Forge",
      "shortName": "Forge",
      "themeColor": "#000000",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Forge uses your photos to let you set a profile picture."
        }
      ]
    ],
    "scheme": "workout",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f1173fe-23f7-499a-badd-8a8670bde344"
      }
    }
  }
}
