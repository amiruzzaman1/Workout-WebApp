{
  "expo": {
    "name": "Forge",
    "slug": "forge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amiruzzaman.forge",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amiruzzaman.forge",
      "versionCode": 2,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Forge",
      "shortName": "Forge",
      "themeColor": "#000000",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Forge uses your photos to let you set a profile picture and add progress photos.",
          "cameraPermission": "Forge uses the camera to take progress photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#000000",
          "sounds": [
          "./assets/sounds/alarm_classic.wav",
          "./assets/sounds/alarm_chime.wav",
          "./assets/sounds/alarm_rising.wav",
          "./assets/sounds/alarm_bells.wav",
          "./assets/sounds/alarm_radar.wav",
          "./assets/sounds/alarm_fast.wav",
          "./assets/sounds/alarm_piano.wav",
          "./assets/sounds/alarm_siren.wav",
          "./assets/sounds/alarm_marimba.wav",
          "./assets/sounds/alarm_powerup.wav"
          ]
        }
      ],
      "expo-speech-recognition",
      "expo-llm-mediapipe",
      "expo-file-system",
      [
        "expo-camera",
        {
          "cameraPermission": "Forge uses your camera to scan a food's barcode.",
          "recordAudioAndroid": false
        }
      ],
      "expo-audio"
    ],
    "scheme": "workout",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9da849d-6118-4731-aa28-846591e238b6"
      }
    }
  }
}
